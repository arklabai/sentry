{
  "name": "sentry-ai-extension",
  "version": "1.0.0",
  "description": "Sentry AI: Be Fearless Online",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node scripts/build-extension.js",
    "build:chrome": "tsc && node scripts/build-extension.js --target=chrome",
    "build:firefox": "tsc && node scripts/build-extension.js --target=firefox",
    "package:chrome": "rm -f sentry-ai-v1.0.0.zip && npm run build:chrome && (cd dist && zip -r ../sentry-ai-v1.0.0.zip .)",
    "package:firefox": "rm -f sentry-ai-firefox-v1.0.0.zip && npm run build:firefox && (cd dist && zip -r ../sentry-ai-firefox-v1.0.0.zip .)",
    "package": "npm run package:chrome && npm run package:firefox",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/chrome": "^0.0.308",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
