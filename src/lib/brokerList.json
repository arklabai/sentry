{
  "templates": {
    "ccpa": {
      "subject": "CCPA / CPRA Request to Delete Personal Information and Opt Out of Sale/Sharing",
      "body": "To the Privacy Officer of {{brokerName}},\n\nI am exercising my rights under the California Consumer Privacy Act (CCPA) and California Privacy Rights Act (CPRA), Cal. Civ. Code § 1798.100 et seq.\n\nI hereby request that you:\n1. Permanently delete all personal information you have collected, purchased, or aggregated about me from your consumer-facing and commercial databases.\n2. Opt me out of any future sale, sharing, or processing of my personal information for commercial modeling, targeted advertising, or AI training datasets.\n\nIdentifier Information:\n- Full Name: {{fullName}}\n- Primary Email: {{primaryEmail}}\n- Phone Number: {{phone}}\n- Location: {{cityState}}, {{country}}\n\nPlease confirm receipt of this request and provide written confirmation within the statutory 45-day deadline.\n\nSincerely,\n{{fullName}}"
    },
    "gdpr": {
      "subject": "GDPR Article 17 & 21 Request: Erasure of Personal Data and Right to Object",
      "body": "To the Data Protection Officer of {{brokerName}},\n\nPursuant to Article 17 ('Right to Erasure / Right to be Forgotten') and Article 21 ('Right to Object') of the EU General Data Protection Regulation (GDPR) (Regulation 2016/679):\n\nI hereby object to the processing of my personal data for profiling, data brokerage, or commercial model training, and request that you immediately erase all personal data concerning me from your systems and notify any third-party recipients to whom the data has been disclosed.\n\nIdentification Details:\n- Name: {{fullName}}\n- Email: {{primaryEmail}}\n- Phone: {{phone}}\n- Region: {{cityState}}, {{country}}\n\nPlease confirm erasure within 30 days as mandated by Article 12(3) GDPR.\n\nRegards,\n{{fullName}}"
    }
  },
